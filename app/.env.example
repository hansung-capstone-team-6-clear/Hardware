# 복사해서 쓴다: cp .env.example .env  (.env는 절대 커밋하지 않는다)

# 백엔드가 도는 노트북 주소. 같은 Wi-Fi에서 노트북 IP 확인: macOS `ipconfig getifaddr en0`, Windows `ipconfig`
BACKEND_URL=http://192.168.0.10:8000

# 이 펫의 사용자 ID (WS 주소와 음성 요청에 쓰인다. MVP는 사용자 1명당 펫 1대)
USER_ID=pet-01

# 백엔드 .env의 DEVICE_TOKEN과 같은 값
DEVICE_TOKEN=change-me

# TTS 목소리 (edge-tts 한국어: ko-KR-SunHiNeural 여성, ko-KR-InJoonNeural 남성)
TTS_VOICE=ko-KR-SunHiNeural
